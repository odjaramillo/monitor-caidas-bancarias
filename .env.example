# Copy this file to .env and fill in the values. Never commit .env.
# In production, each value lives in the platform settings (Render, Vercel).

# API (apps/api)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Allowed origin for CORS (the frontend URL)
CORS_ORIGIN=http://localhost:5173
# Supabase PostgreSQL connection string (pooler URL)
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Upstash Redis URL (rediss:// with TLS)
REDIS_URL=rediss://default:password@host:6379
# Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=
# Sentry DSN for the API
SENTRY_DSN=

# Frontend (apps/web). Vite exposes only variables with the PUBLIC_ prefix.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_TURNSTILE_SITE_KEY=
