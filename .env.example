# Copy this file to .env and fill in the values. Never commit .env.
# In production, each value lives in the platform settings (Render, Vercel).

# API (apps/api)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Allowed origin for CORS (the frontend URL)
CORS_ORIGIN=http://localhost:5173
# PostgreSQL. Local default: the database in compose.yaml. Production: the Supabase pooler URL (port 6543).
DATABASE_URL=postgresql://mcb:mcb@localhost:5432/mcb

# Redis. Local default: the server in compose.yaml. Production: the Upstash URL with TLS (rediss://).
REDIS_URL=redis://localhost:6379
# Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=
# Sentry DSN for the API
SENTRY_DSN=

# Frontend (apps/web). Vite exposes only variables with the PUBLIC_ prefix.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_TURNSTILE_SITE_KEY=
