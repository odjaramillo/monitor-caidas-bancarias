{
  "name": "monitor-caidas-bancarias",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --dir tooling/repo-contract run test && pnpm -r --filter '!repo-contract' --filter '!monitor-caidas-bancarias' test",
    "audit:prod": "node tooling/repo-contract/audit-gate.js",
    "coverage:check": "node tooling/repo-contract/coverage-ratchet.js",
    "coverage:ratchet": "pnpm test && node tooling/repo-contract/coverage-ratchet.js --write",
    "measure:functions": "node tooling/repo-contract/function-shape.js",
    "verify": "pnpm install --frozen-lockfile && pnpm audit:prod && pnpm lint && pnpm typecheck && pnpm test && pnpm coverage:check && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "~3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
